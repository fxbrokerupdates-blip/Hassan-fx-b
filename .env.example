# ============================================================
# FX Broker Updates — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Full reference: ENVIRONMENT_VARIABLES.md
# ============================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development            # development | production

# --- Supabase (required for auth, dashboards and persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                 # server only — never expose

# --- Scheduled jobs (required in production) ---
CRON_SECRET=                               # long random string; sent as Bearer token by the scheduler

# --- AI providers (optional — server only; admin chooses active provider/model in /admin/ai-settings) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=                # e.g. https://api.together.xyz/v1

# --- Bot protection (optional — Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email provider for newsletters / notifications (optional) ---
EMAIL_PROVIDER=                            # resend | (empty = disabled)
RESEND_API_KEY=
EMAIL_FROM="FX Broker Updates <news@fxbrokerupdates.com>"

# --- Web push (optional — OneSignal) ---
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Search Console / external analytics (optional) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
